---
// The DN logo, inlined from the themable master SVG so its colors follow the site theme.
// The master reads --dn-primary, --dn-frame, and --dn-accent; those are set per theme in global.css.
import svg from '../assets/logo/dn-logo-master-themable.svg?raw';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['dn-logo block', className]} aria-hidden="true" set:html={svg} />

<style>
  .dn-logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dn-logo :global(path) {
    transition: fill 0.2s ease;
  }
</style>
