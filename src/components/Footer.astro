---
// Styled like the title block in the corner of an engineering drawing.
import { site } from '../site.config';
import Logo from './Logo.astro';

interface Props {
  sheet?: string;
}
const { sheet = 'Home' } = Astro.props;
const year = new Date().getFullYear();
const cells = [
  { label: 'Drawn by', value: site.name },
  { label: 'Program', value: 'Engineering Transfer — ME' },
  { label: 'School', value: site.school },
  { label: 'Sheet', value: sheet },
  { label: 'Rev', value: String(year) },
];
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex overflow-hidden rounded-md border-2 border-ink/80 bg-surface">
      <!-- Logo cell, like the company mark in a drawing's title block -->
      <div class="grid shrink-0 place-items-center border-r border-line px-4 sm:px-5">
        <Logo class="size-11 sm:size-12" />
      </div>
      <dl class="grid min-w-0 flex-1 grid-cols-2 sm:grid-cols-5">
        {
          cells.map((c) => (
            <div class="min-w-0 border-b border-r border-line px-4 py-3 last:col-span-2 last:border-r-0 last:border-b-0 sm:border-b-0 sm:last:col-span-1">
              <dt class="label">{c.label}</dt>
              <dd class="mt-1 truncate font-mono text-sm">{c.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <p class="mt-4 text-center font-mono text-xs text-muted">
      Hand-built with Astro · hosted on Vercel · all dimensions in inches unless noted
    </p>
  </div>
</footer>
