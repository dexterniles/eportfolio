---
// Slowly spinning 3D model for the home page hero, with edge lines. Drag to turn it;
// zoom and pan are off so the page scrolls normally.
import { projectHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { model, title, coverAlt } = project.data;
---

<figure class="hero-model">
  <div class="crop-marks">
    <div
      class="cad-viewer"
      data-cad-viewer
      data-src={model}
      data-zoom="false"
      data-pan="false"
      data-rotate-speed="24"
      data-rotate-delay="1500"
      data-theta="0"
      data-phi="72"
      role="img"
      aria-label={coverAlt ?? `3D model of ${title}`}
    >
    </div>
  </div>
  <figcaption class="mt-3 flex items-center justify-between gap-3 font-mono text-xs text-muted">
    <span>FIG. 1 · drag to rotate</span>
    <a href={projectHref(project)} class="text-accent hover:underline">{title} →</a>
  </figcaption>
</figure>

<style>
  .cad-viewer {
    /* Fixed height reserves the space before the model loads, so nothing jumps. */
    position: relative;
    display: block;
    width: 100%;
    height: clamp(260px, 42vw, 420px);
    cursor: grab;
  }
  .cad-viewer:active {
    cursor: grabbing;
  }
</style>

<script>
  import { loadCadViewersWhenIdle } from '../lib/load-cad-viewers';

  // Respect reduced motion: no auto-spin.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.hero-model [data-cad-viewer]').forEach((el) => (el.dataset.autoRotate = 'false'));
  }
  loadCadViewersWhenIdle();
</script>
