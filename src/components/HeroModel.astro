---
// Slowly spinning 3D model for the home page hero. Drag to turn it; zoom is off so the page scrolls normally.
import { projectHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { model, title, coverAlt } = project.data;
---

<figure class="hero-model">
  <div class="crop-marks">
  <model-viewer
    src={model}
    alt={coverAlt ?? `3D model of ${title}`}
    camera-controls
    disable-zoom
    disable-pan
    auto-rotate
    auto-rotate-delay="0"
    rotation-per-second="24deg"
    camera-orbit="0deg 72deg auto"
    interaction-prompt="none"
    shadow-intensity="1"
    shadow-softness="0.9"
    exposure="1.05"
    tone-mapping="neutral"
    touch-action="pan-y"
  ></model-viewer>
  </div>
  <figcaption class="mt-3 flex items-center justify-between gap-3 font-mono text-xs text-muted">
    <span>FIG. 1 · drag to rotate</span>
    <a href={projectHref(project)} class="text-accent hover:underline">{title} →</a>
  </figcaption>
</figure>

<style>
  model-viewer {
    /* Block before the script upgrades it, so the height reserves space and nothing jumps. */
    display: block;
    width: 100%;
    height: clamp(260px, 42vw, 420px);
    background: transparent;
    --poster-color: transparent;
    --progress-bar-color: transparent;
  }
</style>

<script>
  // Same lazy-load approach as the project viewer: wait until the page has loaded and gone idle.
  const loadViewer = () => import('@google/model-viewer');
  const whenIdle = (fn: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2500 }) : setTimeout(fn, 300);
  if (document.readyState === 'complete') whenIdle(loadViewer);
  else addEventListener('load', () => whenIdle(loadViewer), { once: true });

  // Respect reduced motion: no auto-spin.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.hero-model model-viewer').forEach((mv) => mv.removeAttribute('auto-rotate'));
  }
</script>
