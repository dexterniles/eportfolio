---
// Interactive 3D viewer for .glb files in /public, with SolidWorks-style edge lines.
// three.js loads only on pages that use it (see src/lib/load-cad-viewers.ts).
// Assemblies (multi-part .glb from `npm run step2glb`) also get an Explode/Collapse button
// and a color key that names each part and links to its page.
import { getCollection } from 'astro:content';
import { partName } from '../data/part-numbers';
import { readGlbParts } from '../lib/glb-parts';
import { projectHref } from '../lib/projects';

interface Props {
  src: string;
  alt: string;
  explode?: Record<string, number[]>; // per-part explode offsets (see CadViewerOptions.explode)
  labels?: Record<string, string>; // names for parts without a project page of their own
  view?: { theta?: number; phi?: number }; // starting camera angle, degrees
}
const { src, alt, explode, labels = {}, view } = Astro.props;

// Color key: each part number, linked to its project page when there is one ("A1005 · …"), or to
// McMaster-Carr for purchased hardware. Named by that page's title, else `labels`, else the official
// part number list (src/data/part-numbers.ts), else the CAD file's description or supplier number.
const parts = readGlbParts(src);
const projects = parts.length ? await getCollection('projects') : [];
const key = parts.map((p) => {
  const page = projects.find((q) => q.data.title.toUpperCase().startsWith(`${p.part} ·`));
  const supplier = p.vendor && `McMaster-Carr ${p.vendor}`;
  return {
    ...p,
    name: page?.data.title.split(' · ').slice(1).join(' · ') ?? labels[p.part] ?? partName(p.part) ?? p.label ?? supplier ?? '',
    href: page ? projectHref(page) : p.vendor ? `https://www.mcmaster.com/${p.vendor}` : undefined,
    external: !page && Boolean(p.vendor),
  };
});
const placedCount = parts.reduce((n, p) => n + p.count, 0);
---

<figure class="model-frame crop-marks">
  <div data-stage class="relative overflow-hidden rounded-md border border-line bg-surface/60">
    <div
      class="cad-viewer"
      data-cad-viewer
      data-src={src}
      data-explode={explode && JSON.stringify(explode)}
      data-theta={view?.theta}
      data-phi={view?.phi}
      role="img"
      aria-label={alt}
      tabindex="0"
      aria-describedby="viewer-keys"
    >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-0.5 transition-opacity">
        <div data-progress class="h-full w-0 bg-accent transition-[width]"></div>
      </div>
    </div>

    <div class="absolute right-3 top-3 flex gap-2">
      {
        parts.length > 0 && (
          <button type="button" data-explode-toggle class="mv-btn" aria-label="Explode parts" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 9h6v6H9z" />
              <path d="M3 3l3 3M21 3l-3 3M3 21l3-3M21 21l-3-3" stroke-linecap="round" />
            </svg>
          </button>
        )
      }
      <button type="button" data-edges class="mv-btn" aria-label="Hide edge lines" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 20 7.5v9L12 21l-8-4.5v-9z" /><path d="M4 7.5 12 12l8-4.5M12 12v9" /></svg>
      </button>
      <button type="button" data-reset class="mv-btn" aria-label="Reset view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
      </button>
      <button type="button" data-spin class="mv-btn" aria-label="Pause rotation" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4" /><path d="M21 3v6h-6" /></svg>
      </button>
      <button type="button" data-full class="mv-btn" aria-label="View fullscreen" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
      </button>
    </div>
  </div>
  <figcaption class="mt-3 flex flex-wrap justify-between gap-2 font-mono text-xs text-muted">
    <span id="viewer-keys">
      Drag to rotate · scroll or pinch to zoom · right-drag to pan · arrow keys rotate{parts.length > 0 && ' · E explodes'}
    </span>
    <a href={src} download data-astro-prefetch="false" class="text-accent hover:underline">Download .glb</a>
  </figcaption>
  {
    key.length > 0 && (
      <div class="mt-4 rounded-md border border-line bg-surface">
        <p class="label border-b border-line px-4 py-2.5">
          Parts · {key.length} part numbers, {placedCount} pieces · hover to highlight
        </p>
        <ul class="grid grid-cols-1 py-1 sm:grid-cols-2" data-part-key>
          {key.map((p) => {
            const row = (
              <>
                <span class="size-3.5 shrink-0 rounded-sm border border-ink/20" style={`background:${p.color}`} aria-hidden="true" />
                <span class="font-mono text-sm font-semibold">{p.part}</span>
                <span class="min-w-0 truncate text-sm text-muted" title={p.name}>{p.name}</span>
                <span class="ml-auto shrink-0 font-mono text-xs text-muted">×{p.count}</span>
              </>
            );
            const cls = 'flex items-center gap-3 px-4 py-1.5';
            return (
              <li data-part={p.part}>
                {p.href ? (
                  <a
                    href={p.href}
                    class={`${cls} transition hover:bg-paper hover:text-accent`}
                    {...(p.external && { target: '_blank', rel: 'noopener' })}
                  >
                    {row}
                    {/* Appended rather than an aria-label, so the accessible name still contains the visible text (WCAG 2.5.3). */}
                    {p.external && <span class="sr-only">(opens McMaster-Carr in a new tab)</span>}
                  </a>
                ) : (
                  <span class={cls} tabindex="0">
                    {row}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</figure>

<style>
  .cad-viewer {
    /* Fixed height reserves the space before the model loads, so nothing jumps. */
    position: relative;
    display: block;
    width: 100%;
    /* Shorter on phones so there's always page left above or below to swipe-scroll on. */
    height: clamp(300px, 55vh, 600px);
    cursor: grab;
    outline: none;
  }
  @media (min-width: 640px) {
    .cad-viewer {
      height: clamp(320px, 62vh, 600px);
    }
  }
  .cad-viewer:active {
    cursor: grabbing;
  }
  .cad-viewer:focus-visible {
    box-shadow: inset 0 0 0 2px var(--highlight);
  }
  [data-stage]:fullscreen {
    background: var(--paper);
    border-radius: 0;
  }
  [data-stage]:fullscreen .cad-viewer {
    height: 100dvh;
  }
  .mv-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-muted);
    transition: color 0.15s, border-color 0.15s;
  }
  .mv-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .mv-btn[aria-pressed='false'] {
    color: var(--highlight);
  }
  /* Explode is off by default, so it lights up when on rather than when off. */
  .mv-btn[data-explode-toggle][aria-pressed='false'] {
    color: var(--ink-muted);
  }
  .mv-btn[data-explode-toggle][aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .mv-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>

<script>
  import { loadCadViewersWhenIdle, type CadViewerElement } from '../lib/load-cad-viewers';

  loadCadViewersWhenIdle();

  document.querySelectorAll<HTMLElement>('.model-frame').forEach((frame) => {
    const stage = frame.querySelector<HTMLElement>('[data-stage]')!;
    const el = frame.querySelector<CadViewerElement>('[data-cad-viewer]')!;
    const spin = frame.querySelector<HTMLButtonElement>('[data-spin]')!;
    const edges = frame.querySelector<HTMLButtonElement>('[data-edges]')!;
    const full = frame.querySelector<HTMLButtonElement>('[data-full]')!;

    // Buttons store their state in data-* attributes, so clicks before the viewer
    // finishes loading still take effect when it starts.
    const toggle = (btn: HTMLButtonElement, attr: 'autoRotate' | 'edges', labels: [string, string]) => {
      const on = el.dataset[attr] === 'false';
      el.dataset[attr] = String(on);
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? labels[0] : labels[1]);
      if (attr === 'autoRotate') el.cadViewer?.setAutoRotate(on);
      else el.cadViewer?.setEdges(on);
    };
    spin.addEventListener('click', () => toggle(spin, 'autoRotate', ['Pause rotation', 'Resume rotation']));
    edges.addEventListener('click', () => toggle(edges, 'edges', ['Hide edge lines', 'Show edge lines']));
    frame.querySelector('[data-reset]')!.addEventListener('click', () => el.cadViewer?.reset());

    // Assemblies: explode / collapse, and highlight a part from the color key.
    const explode = frame.querySelector<HTMLButtonElement>('[data-explode-toggle]');
    const toggleExplode = () => {
      if (!explode) return;
      const on = el.dataset.exploded !== 'true';
      el.dataset.exploded = String(on);
      explode.setAttribute('aria-pressed', String(on));
      explode.setAttribute('aria-label', on ? 'Collapse parts' : 'Explode parts');
      el.cadViewer?.setExploded(on);
    };
    explode?.addEventListener('click', toggleExplode);
    frame.querySelectorAll<HTMLElement>('[data-part]').forEach((row) => {
      const on = () => el.cadViewer?.highlight(row.dataset.part!);
      const off = () => el.cadViewer?.highlight(null);
      row.addEventListener('mouseenter', on);
      row.addEventListener('mouseleave', off);
      row.addEventListener('focusin', on);
      row.addEventListener('focusout', off);
    });

    // Keyboard: arrows rotate, +/- zoom, 0 resets, E explodes.
    el.addEventListener('keydown', (e) => {
      const v = el.cadViewer;
      if (!v) return;
      const keys: Record<string, () => void> = {
        ArrowLeft: () => v.rotateBy(-15),
        ArrowRight: () => v.rotateBy(15),
        '+': () => v.zoomBy(0.85),
        '=': () => v.zoomBy(0.85),
        '-': () => v.zoomBy(1.18),
        '0': () => v.reset(),
        ...(explode && { e: toggleExplode, E: toggleExplode }),
      };
      if (keys[e.key]) {
        e.preventDefault();
        keys[e.key]();
      }
    });

    // Respect reduced motion: start paused.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) spin.click();

    // Element fullscreen isn't available on iPhone, so only show the button where it works.
    if (document.fullscreenEnabled) {
      full.hidden = false;
      full.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else stage.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', () => {
        full.setAttribute('aria-label', document.fullscreenElement ? 'Exit fullscreen' : 'View fullscreen');
      });
    }
  });
</script>
