---
// Interactive 3D viewer for .glb files in /public, with SolidWorks-style edge lines.
// three.js loads only on pages that use it (see src/lib/load-cad-viewers.ts).
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<figure class="model-frame crop-marks">
  <div data-stage class="relative overflow-hidden rounded-md border border-line bg-surface/60">
    <div
      class="cad-viewer"
      data-cad-viewer
      data-src={src}
      role="img"
      aria-label={alt}
      tabindex="0"
      aria-describedby="viewer-keys"
    >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-0.5 transition-opacity">
        <div data-progress class="h-full w-0 bg-accent transition-[width]"></div>
      </div>
    </div>

    <div class="absolute right-3 top-3 flex gap-2">
      <button type="button" data-edges class="mv-btn" aria-label="Hide edge lines" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 20 7.5v9L12 21l-8-4.5v-9z" /><path d="M4 7.5 12 12l8-4.5M12 12v9" /></svg>
      </button>
      <button type="button" data-reset class="mv-btn" aria-label="Reset view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
      </button>
      <button type="button" data-spin class="mv-btn" aria-label="Pause rotation" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4" /><path d="M21 3v6h-6" /></svg>
      </button>
      <button type="button" data-full class="mv-btn" aria-label="View fullscreen" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
      </button>
    </div>
  </div>
  <figcaption class="mt-3 flex flex-wrap justify-between gap-2 font-mono text-xs text-muted">
    <span id="viewer-keys">Drag to rotate · scroll or pinch to zoom · right-drag to pan · arrow keys rotate</span>
    <a href={src} download class="text-accent hover:underline">Download .glb</a>
  </figcaption>
</figure>

<style>
  .cad-viewer {
    /* Fixed height reserves the space before the model loads, so nothing jumps. */
    position: relative;
    display: block;
    width: 100%;
    height: clamp(320px, 62vh, 600px);
    cursor: grab;
    outline: none;
  }
  .cad-viewer:active {
    cursor: grabbing;
  }
  .cad-viewer:focus-visible {
    box-shadow: inset 0 0 0 2px var(--highlight);
  }
  [data-stage]:fullscreen {
    background: var(--paper);
    border-radius: 0;
  }
  [data-stage]:fullscreen .cad-viewer {
    height: 100dvh;
  }
  .mv-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-muted);
    transition: color 0.15s, border-color 0.15s;
  }
  .mv-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .mv-btn[aria-pressed='false'] {
    color: var(--highlight);
  }
  .mv-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>

<script>
  import { loadCadViewersWhenIdle, type CadViewerElement } from '../lib/load-cad-viewers';

  loadCadViewersWhenIdle();

  document.querySelectorAll<HTMLElement>('.model-frame').forEach((frame) => {
    const stage = frame.querySelector<HTMLElement>('[data-stage]')!;
    const el = frame.querySelector<CadViewerElement>('[data-cad-viewer]')!;
    const spin = frame.querySelector<HTMLButtonElement>('[data-spin]')!;
    const edges = frame.querySelector<HTMLButtonElement>('[data-edges]')!;
    const full = frame.querySelector<HTMLButtonElement>('[data-full]')!;

    // Buttons store their state in data-* attributes, so clicks before the viewer
    // finishes loading still take effect when it starts.
    const toggle = (btn: HTMLButtonElement, attr: 'autoRotate' | 'edges', labels: [string, string]) => {
      const on = el.dataset[attr] === 'false';
      el.dataset[attr] = String(on);
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? labels[0] : labels[1]);
      if (attr === 'autoRotate') el.cadViewer?.setAutoRotate(on);
      else el.cadViewer?.setEdges(on);
    };
    spin.addEventListener('click', () => toggle(spin, 'autoRotate', ['Pause rotation', 'Resume rotation']));
    edges.addEventListener('click', () => toggle(edges, 'edges', ['Hide edge lines', 'Show edge lines']));
    frame.querySelector('[data-reset]')!.addEventListener('click', () => el.cadViewer?.reset());

    // Keyboard: arrows rotate, +/- zoom, 0 resets.
    el.addEventListener('keydown', (e) => {
      const v = el.cadViewer;
      if (!v) return;
      const keys: Record<string, () => void> = {
        ArrowLeft: () => v.rotateBy(-15),
        ArrowRight: () => v.rotateBy(15),
        '+': () => v.zoomBy(0.85),
        '=': () => v.zoomBy(0.85),
        '-': () => v.zoomBy(1.18),
        '0': () => v.reset(),
      };
      if (keys[e.key]) {
        e.preventDefault();
        keys[e.key]();
      }
    });

    // Respect reduced motion: start paused.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) spin.click();

    // Element fullscreen isn't available on iPhone, so only show the button where it works.
    if (document.fullscreenEnabled) {
      full.hidden = false;
      full.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else stage.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', () => {
        full.setAttribute('aria-label', document.fullscreenElement ? 'Exit fullscreen' : 'View fullscreen');
      });
    }
  });
</script>
