---
interface Props {
  label: string;
  address: string;
}
const { label, address } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-line bg-surface px-4 py-3">
  <div class="min-w-0">
    <p class="label">{label}</p>
    <a href={`mailto:${address}`} class="mt-0.5 block break-all font-mono text-sm hover:text-accent sm:text-base">
      {address}
    </a>
  </div>
  <button
    type="button"
    data-copy={address}
    class="copy-btn shrink-0 rounded-md border border-line px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-muted transition hover:border-accent hover:text-accent"
    aria-label={`Copy ${label.toLowerCase()} email address`}
  >
    <span data-idle>Copy</span><span data-done hidden>Copied ✓</span>
  </button>
</div>
