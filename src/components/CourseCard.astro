---
import type { Course } from '../data/courses';

interface Props {
  course: Course;
  count: number;
}
const { course, count } = Astro.props;
---

<a
  href={`/${course.slug}`}
  class="group relative flex h-full flex-col rounded-md border-2 border-line bg-surface p-6 transition hover:-translate-y-1 hover:border-accent hover:shadow-[6px_6px_0_var(--accent)]"
>
  <div class="flex items-start justify-between gap-4">
    <span class="font-mono text-2xl font-bold text-accent">{course.code}</span>
    <span class="label rounded border border-line px-2 py-1">{course.software}</span>
  </div>
  <h3 class="mt-3 text-xl font-semibold">{course.title}</h3>
  <p class="mt-2 text-muted">{course.summary}</p>
  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Sections">
    {course.sections.map((s) => <li class="label rounded-full border border-dashed border-line px-2.5 py-1">{s.title}</li>)}
  </ul>
  <div class="mt-auto flex items-center justify-between pt-6">
    <span class="label">{count > 0 ? `${count} project${count === 1 ? '' : 's'}` : 'In progress'}</span>
    <span class="font-mono text-sm text-accent transition group-hover:translate-x-1" aria-hidden="true">Open →</span>
  </div>
</a>
