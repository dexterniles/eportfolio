---
import { getCollection, getEntry } from 'astro:content';
import HeroModel from '../components/HeroModel.astro';
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { site } from '../site.config';
import { courses } from '../data/courses';

const projects = await getCollection('projects', (p) => !p.data.placeholder);
const countFor = (slug: string) => projects.filter((p) => p.data.course === slug).length;

// The spinning model in the hero. Point this at any project with a model (or remove it to hide the viewer).
const heroModel = await getEntry('projects', 'cad111/models/a1005');
---

<Base sheet="Home">
  <!-- Hero -->
  <section class="grid items-center gap-10 py-16 md:py-28 lg:grid-cols-[minmax(0,1fr)_26rem]">
    <div class="rise">
      <p class="label">{site.program}</p>
      <h1 class="mt-3 text-5xl font-bold tracking-tight sm:text-7xl md:text-8xl">
        {site.name.split(' ')[0]} <span class="text-accent">{site.name.split(' ').slice(1).join(' ')}</span>
      </h1>
      <!-- Dimension line under the name -->
      <div class="mt-5 flex max-w-xl items-center gap-2 text-accent" aria-hidden="true">
        <span class="h-3 border-l-2 border-current"></span>
        <span class="dim-line h-px flex-1 bg-current"></span>
        <span class="h-3 border-l-2 border-current"></span>
      </div>
      <p class="mt-5 max-w-xl text-lg text-muted">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#coursework"
          class="rounded-md bg-accent px-5 py-2.5 font-medium text-accent-ink transition hover:-translate-y-0.5 hover:shadow-[4px_4px_0_var(--highlight)]"
          >See my work</a
        >
        <a
          href="#contact"
          class="rounded-md border-2 border-line px-5 py-2.5 font-medium transition hover:border-accent hover:text-accent"
          >Get in touch</a
        >
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener"
          class="grid size-12 place-items-center rounded-md border-2 border-line transition hover:border-accent hover:text-accent"
          aria-label="LinkedIn profile (opens in a new tab)"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3v-11zm6.5 0h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4v-11z" />
          </svg>
        </a>
      </div>
    </div>
    {
      heroModel && (
        <div class="rise" style="animation-delay: 120ms">
          <HeroModel project={heroModel} />
        </div>
      )
    }
  </section>

  <!-- About -->
  <section aria-labelledby="about-title" class="grid gap-10 border-t border-line py-16 md:grid-cols-[1fr_20rem]">
    <div>
      <p class="label">01 — About</p>
      <h2 id="about-title" class="mt-2 text-3xl font-bold tracking-tight">Hi, I'm {site.name.split(' ')[0]}.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed">{site.intro}</p>
    </div>
    <aside class="h-fit rounded-md border border-line bg-surface p-5">
      <dl class="space-y-4">
        <div>
          <dt class="label">School</dt>
          <dd class="mt-1">{site.school}</dd>
        </div>
        <div>
          <dt class="label">Program</dt>
          <dd class="mt-1">Engineering Transfer, Mechanical Engineering focus</dd>
        </div>
        <div>
          <dt class="label">Tools</dt>
          <dd class="mt-2 flex flex-wrap gap-2">
            {site.skills.map((s) => <span class="rounded border border-accent/50 bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent">{s}</span>)}
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <!-- Coursework -->
  <section id="coursework" aria-labelledby="coursework-title" class="scroll-mt-20 border-t border-line py-16">
    <p class="label">02 — Coursework</p>
    <h2 id="coursework-title" class="mt-2 text-3xl font-bold tracking-tight">What I'm building</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {courses.map((c) => <CourseCard course={c} count={countFor(c.slug)} />)}
      <div class="grid place-items-center rounded-md border-2 border-dashed border-line p-6 text-center">
        <div>
          <p class="font-mono text-2xl text-muted" aria-hidden="true">+</p>
          <p class="mt-2 font-medium">More courses on the way</p>
          <p class="mt-1 text-sm text-muted">New classes get added here as I take them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" aria-labelledby="contact-title" class="scroll-mt-20 border-t border-line py-16">
    <p class="label">03 — Contact</p>
    <h2 id="contact-title" class="mt-2 text-3xl font-bold tracking-tight">Let's connect</h2>
    <p class="mt-3 max-w-xl text-muted">Classmates, instructors, and employers are all welcome to reach out.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {site.emails.map((e) => <CopyEmail label={e.label} address={e.address} />)}
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-between gap-3 rounded-md border border-line bg-surface px-4 py-3 transition hover:border-accent"
      >
        <span>
          <span class="label block">LinkedIn</span>
          <span class="mt-0.5 block font-mono text-sm sm:text-base">in/dexterniles</span>
        </span>
        <span class="font-mono text-sm text-accent" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      {
        site.resume && (
          <a
            href={site.resume}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-3 rounded-md border border-line bg-surface px-4 py-3 transition hover:border-accent"
          >
            <span>
              <span class="label block">Résumé</span>
              <span class="mt-0.5 block font-mono text-sm sm:text-base">PDF</span>
            </span>
            <span class="font-mono text-sm text-accent" aria-hidden="true">↓</span>
          </a>
        )
      }
    </div>
    <p class="sr-only" aria-live="polite" id="copy-status"></p>
  </section>
</Base>

<style>
  .rise {
    animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
  }
  .dim-line {
    transform-origin: center;
    animation: draw 0.8s 0.4s ease-out both;
  }
  @keyframes draw {
    from { transform: scaleX(0); }
  }
</style>

<script>
  const status = document.getElementById('copy-status');
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return; // Clipboard blocked; the address is still visible to copy by hand.
      }
      const idle = btn.querySelector<HTMLElement>('[data-idle]')!;
      const done = btn.querySelector<HTMLElement>('[data-done]')!;
      idle.hidden = true;
      done.hidden = false;
      if (status) status.textContent = `${text} copied to clipboard`;
      setTimeout(() => {
        idle.hidden = false;
        done.hidden = true;
      }, 1800);
    });
  });
</script>
