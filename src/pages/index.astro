---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import HeroModel from '../components/HeroModel.astro';
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { site } from '../site.config';
import { courses } from '../data/courses';
import { getCompetency } from '../data/competencies';
import { getGroupProjects, getShowcaseGroups, zones } from '../lib/showcase';

const projects = await getCollection('projects', (p) => !p.data.placeholder);
const countFor = (slug: string) => projects.filter((p) => p.data.course === slug).length;
const activeSectionsFor = (slug: string) => [...new Set(projects.filter((p) => p.data.course === slug).map((p) => p.data.section))];
// Courses with project sections get big cards; the rest are listed compactly as outline courses.
const projectCourses = courses.filter((c) => c.sections.length > 0);
const outlineCourses = courses.filter((c) => c.sections.length === 0);

// The spinning model in the hero. Point this at any project with a model (or remove it to hide the viewer).
const heroModel = await getEntry('projects', 'cad111/models/a1005');

// Portfolio teaser: each showcase group with its first example's cover.
const showcase = await Promise.all(
  (await getShowcaseGroups()).map(async (group) => {
    const examples = await getGroupProjects(group);
    return { group, count: examples.length, cover: examples.find((p) => p.data.cover)?.data };
  }),
);
---

<Base sheet="Home">
  <!-- Hero -->
  <section class="grid items-center gap-10 py-16 md:py-28 lg:grid-cols-[minmax(0,1fr)_26rem]">
    <div class="rise">
      <p class="label">{site.program}</p>
      <h1 class="mt-3 text-5xl font-bold tracking-tight sm:text-7xl md:text-8xl">
        {site.name.split(' ')[0]} <span class="text-accent">{site.name.split(' ').slice(1).join(' ')}</span>
      </h1>
      <!-- Dimension line under the name -->
      <div class="mt-5 flex max-w-xl items-center gap-2 text-accent" aria-hidden="true">
        <span class="h-3 border-l-2 border-current"></span>
        <span class="dim-line h-px flex-1 bg-current"></span>
        <span class="h-3 border-l-2 border-current"></span>
      </div>
      <p class="mt-5 max-w-xl text-lg text-muted">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={showcase.length > 0 ? '/portfolio' : '#coursework'}
          class="rounded-md bg-accent px-5 py-2.5 font-medium text-accent-ink transition hover:-translate-y-0.5 hover:shadow-[4px_4px_0_var(--highlight)]"
          >See my work</a
        >
        <a
          href="#contact"
          class="rounded-md border-2 border-line px-5 py-2.5 font-medium transition hover:border-accent hover:text-accent"
          >Get in touch</a
        >
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener"
          class="grid size-12 place-items-center rounded-md border-2 border-line transition hover:border-accent hover:text-accent"
          aria-label="LinkedIn profile (opens in a new tab)"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3v-11zm6.5 0h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4v-11z" />
          </svg>
        </a>
      </div>
    </div>
    {
      heroModel && (
        <div class="rise" style="animation-delay: 120ms">
          <HeroModel project={heroModel} />
        </div>
      )
    }
  </section>

  <!-- About -->
  <section aria-labelledby="about-title" class="grid gap-10 border-t border-line py-16 md:grid-cols-[1fr_20rem]">
    <div>
      <p class="label">01 — About</p>
      <h2 id="about-title" class="mt-2 text-3xl font-bold tracking-tight">Hi, I'm {site.name.split(' ')[0]}.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed">{site.intro}</p>
    </div>
    <aside class="h-fit rounded-md border border-line bg-surface p-5">
      <dl class="space-y-4">
        <div>
          <dt class="label">School</dt>
          <dd class="mt-1">{site.school}</dd>
        </div>
        <div>
          <dt class="label">Program</dt>
          <dd class="mt-1">Engineering Transfer, Mechanical Engineering focus</dd>
        </div>
        <div>
          <dt class="label">Tools</dt>
          <dd class="mt-2 flex flex-wrap gap-2">
            {site.skills.map((s) => <span class="rounded border border-accent/50 bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent">{s}</span>)}
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <!-- Portfolio teaser -->
  {
    showcase.length > 0 && (
      <section id="portfolio" aria-labelledby="portfolio-title" class="scroll-mt-20 border-t border-line py-16">
        <p class="label">02 — Portfolio</p>
        <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
          <h2 id="portfolio-title" class="text-3xl font-bold tracking-tight">Selected work</h2>
          <a href="/portfolio" class="font-mono text-sm text-accent hover:underline hover:underline-offset-4">
            View the portfolio →
          </a>
        </div>
        <p class="mt-3 max-w-2xl text-muted">My best CAD work, grouped by skill set, with what each group taught me and where it applies.</p>
        <ul class="mt-8 grid gap-6 md:grid-cols-3">
          {showcase.map(({ group, count, cover }, i) => (
            <li>
              <a
                href={`/portfolio#${group.id}`}
                class="group flex h-full flex-col overflow-hidden rounded-md border-2 border-line bg-surface transition hover:-translate-y-1 hover:border-accent hover:shadow-[6px_6px_0_var(--accent)]"
              >
                {cover?.cover && (
                  <div class="aspect-[3/2] overflow-hidden border-b border-line bg-paper">
                    <Image
                      src={cover.cover}
                      alt=""
                      width={640}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-center gap-3">
                    <span class="grid size-8 shrink-0 place-items-center rounded-full border-2 border-accent font-mono text-sm font-bold text-accent" aria-hidden="true">
                      {zones[i]}
                    </span>
                    <h3 class="text-lg font-semibold leading-snug group-hover:text-accent">{group.data.title}</h3>
                  </div>
                  <p class="mt-3 text-sm text-muted">{group.data.summary}</p>
                  <ul class="mt-auto flex flex-wrap gap-2 pt-4" aria-label="Competencies">
                    {group.data.competencies.map((c) => (
                      <li class="rounded border border-accent/50 px-2 py-0.5 font-mono text-[0.7rem] text-accent">{getCompetency(c).title}</li>
                    ))}
                  </ul>
                  <p class="label mt-4">{count} example{count === 1 ? '' : 's'}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Coursework -->
  <section id="coursework" aria-labelledby="coursework-title" class="scroll-mt-20 border-t border-line py-16">
    <p class="label">{showcase.length > 0 ? '03' : '02'} — Coursework</p>
    <h2 id="coursework-title" class="mt-2 text-3xl font-bold tracking-tight">What I'm building</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {projectCourses.map((c) => <CourseCard course={c} count={countFor(c.slug)} activeSections={activeSectionsFor(c.slug)} />)}
    </div>

    {
      outlineCourses.length > 0 && (
        <div class="mt-12">
          <h3 class="label">Other coursework</h3>
          <ul class="mt-4 divide-y divide-line overflow-hidden rounded-md border border-line bg-surface">
            {outlineCourses.map((c) => (
              <li>
                <a
                  href={`/${c.slug}`}
                  class="group grid gap-1 px-5 py-4 transition hover:bg-paper sm:grid-cols-[8rem_1fr_auto] sm:items-baseline sm:gap-4"
                >
                  <span class="font-mono font-bold text-accent">{c.code}</span>
                  <span>
                    <span class="font-semibold group-hover:text-accent">{c.title}</span>
                    <span class="mt-0.5 block text-sm text-muted">{c.summary}</span>
                  </span>
                  <span class="label whitespace-nowrap">
                    {c.term} · {c.status}
                    <span class="ml-2 text-accent transition group-hover:translate-x-1" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <!-- Contact -->
  <section id="contact" aria-labelledby="contact-title" class="scroll-mt-20 border-t border-line py-16">
    <p class="label">{showcase.length > 0 ? '04' : '03'} — Contact</p>
    <h2 id="contact-title" class="mt-2 text-3xl font-bold tracking-tight">Let's connect</h2>
    <p class="mt-3 max-w-xl text-muted">Classmates, instructors, and employers are all welcome to reach out.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {site.emails.map((e) => <CopyEmail label={e.label} address={e.address} />)}
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-between gap-3 rounded-md border border-line bg-surface px-4 py-3 transition hover:border-accent"
      >
        <span>
          <span class="label block">LinkedIn</span>
          <span class="mt-0.5 block font-mono text-sm sm:text-base">in/dexterniles</span>
        </span>
        <span class="font-mono text-sm text-accent" aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      {
        site.resume && (
          <a
            href={site.resume}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-3 rounded-md border border-line bg-surface px-4 py-3 transition hover:border-accent"
          >
            <span>
              <span class="label block">Résumé</span>
              <span class="mt-0.5 block font-mono text-sm sm:text-base">PDF</span>
            </span>
            <span class="font-mono text-sm text-accent" aria-hidden="true">↓</span>
          </a>
        )
      }
    </div>
    <p class="sr-only" aria-live="polite" id="copy-status"></p>
  </section>
</Base>

<style>
  .rise {
    animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
  }
  .dim-line {
    transform-origin: center;
    animation: draw 0.8s 0.4s ease-out both;
  }
  @keyframes draw {
    from { transform: scaleX(0); }
  }
</style>

<script>
  const status = document.getElementById('copy-status');
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return; // Clipboard blocked; the address is still visible to copy by hand.
      }
      const idle = btn.querySelector<HTMLElement>('[data-idle]')!;
      const done = btn.querySelector<HTMLElement>('[data-done]')!;
      idle.hidden = true;
      done.hidden = false;
      if (status) status.textContent = `${text} copied to clipboard`;
      setTimeout(() => {
        idle.hidden = false;
        done.hidden = true;
      }, 1800);
    });
  });
</script>
