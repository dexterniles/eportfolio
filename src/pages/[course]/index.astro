---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { courses, type Course } from '../../data/courses';
import { getCourseProjects, groupAnchor } from '../../lib/projects';

export function getStaticPaths() {
  return courses.map((course) => ({ params: { course: course.slug }, props: { course } }));
}

const { course } = Astro.props as { course: Course };
const projects = await getCourseProjects(course.slug);
// Only sections with at least one project are shown; they reappear automatically once work is added.
const visibleSections = course.sections.filter((s) => projects.some((p) => p.data.section === s.slug));
const zones = 'ABCDEFGH';
---

<Base title={course.code} description={course.summary} sheet={course.code}>
  <nav aria-label="Breadcrumb" class="pt-10 font-mono text-xs text-muted">
    <a href="/" class="hover:text-accent">Home</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page">{course.code}</span>
  </nav>

  <header class="py-8">
    <p class="label">Course · {course.software}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-6xl">
      <span class="font-mono text-accent">{course.code}</span>
      <span class="mt-1 block text-2xl font-semibold text-ink sm:text-3xl">{course.title}</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{course.summary}</p>

    <div class="mt-8 grid gap-6 md:grid-cols-[14rem_1fr]">
      <dl class="h-fit space-y-4 rounded-md border border-line bg-surface p-5">
        <div>
          <dt class="label">Term</dt>
          <dd class="mt-1 font-mono text-sm">{course.term}</dd>
        </div>
        <div>
          <dt class="label">Status</dt>
          <dd class="mt-1 font-mono text-sm">{course.status}</dd>
        </div>
        <div>
          <dt class="label">Tools</dt>
          <dd class="mt-1 font-mono text-sm">{course.software}</dd>
        </div>
      </dl>
      <div>
        <h2 class="label">Topics covered</h2>
        <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
          {
            course.topics.map((t) => (
              <li class="flex gap-2.5">
                <span class="mt-2 size-1.5 shrink-0 rotate-45 bg-accent" aria-hidden="true" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

  </header>

  {
    /* Section bar: stays under the site header while scrolling, and marks the section in view. */
    visibleSections.length > 1 && (
      <nav
        aria-label="Sections"
        id="section-bar"
        class="sticky top-(--header-h) z-30 -mx-4 border-y border-line bg-paper/85 px-4 py-2.5 backdrop-blur sm:-mx-6 sm:px-6"
      >
        <ul class="flex gap-2 overflow-x-auto [scrollbar-width:none]">
          {visibleSections.map((s, i) => (
            <li class="shrink-0">
              <a
                href={`#${s.slug}`}
                data-section={s.slug}
                class="flex items-center gap-2 whitespace-nowrap rounded-md border border-line bg-surface px-3 py-2 font-mono text-xs uppercase tracking-widest transition hover:border-accent hover:text-accent aria-[current=true]:border-accent aria-[current=true]:text-accent"
              >
                <span class="text-accent">{zones[i]}</span> {s.title}
                <span class="text-muted">{projects.filter((p) => p.data.section === s.slug).length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    visibleSections.map((s, i) => {
      const items = projects.filter((p) => p.data.section === s.slug);
      // Long sections are split into groups (src/data/courses.ts); ungrouped projects go last, under "Other".
      const groups = s.groups?.length
        ? [
            ...s.groups.map((g) => ({ ...g, items: items.filter((p) => p.data.group === g.slug) })),
            { slug: 'other', title: 'Other', blurb: undefined, link: undefined, items: items.filter((p) => !p.data.group) },
          ].filter((g) => g.items.length > 0)
        : [];
      return (
        <section id={s.slug} aria-labelledby={`${s.slug}-title`} class:list={['scroll-mt-(--anchor-offset) border-line py-12', { 'border-t': !(i === 0 && visibleSections.length > 1) }]}>
          <div class="flex items-baseline gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-accent font-mono font-bold text-accent" aria-hidden="true">
              {zones[i]}
            </span>
            <div>
              <h2 id={`${s.slug}-title`} class="text-2xl font-bold tracking-tight">{s.title}</h2>
              <p class="mt-1 text-muted">{s.blurb}</p>
            </div>
          </div>

          {groups.length === 0 ? (
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((p) => (
                <li>
                  <ProjectCard project={p} />
                </li>
              ))}
            </ul>
          ) : (
            <>
              <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Groups in ${s.title}`}>
                {groups.map((g, j) => (
                  <li>
                    <a
                      href={`#${groupAnchor(s.slug, g.slug)}`}
                      class="label block rounded-md border border-dashed border-line px-3 py-1.5 transition hover:border-accent hover:text-accent"
                    >
                      <span class="text-accent">{zones[i]}{j + 1}</span> {g.title}
                      <span aria-hidden="true">&nbsp;· {g.items.length}</span>
                      <span class="sr-only">({g.items.length})</span>
                    </a>
                  </li>
                ))}
              </ul>
              {groups.map((g, j) => (
                <div id={groupAnchor(s.slug, g.slug)} class="mt-12 scroll-mt-(--anchor-offset)">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-dashed border-line pb-3">
                    <h3 class="text-xl font-semibold tracking-tight">
                      <span class="mr-2 font-mono text-base text-accent">{zones[i]}{j + 1}</span>
                      {g.title}
                      <span class="label ml-2">{g.items.length} {g.items.length === 1 ? 'project' : 'projects'}</span>
                    </h3>
                    {g.link && (
                      <a href={g.link.href} class="font-mono text-sm text-accent hover:underline hover:underline-offset-4">
                        {g.link.label} →
                      </a>
                    )}
                  </div>
                  {g.blurb && <p class="mt-2 text-sm text-muted">{g.blurb}</p>}
                  <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {g.items.map((p) => (
                      <li>
                        <ProjectCard project={p} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </>
          )}
        </section>
      );
    })
  }

  {
    course.sections.length > 0 && visibleSections.length === 0 && (
      <p class="border-t border-line py-12 text-center font-mono text-sm text-muted">Projects coming soon.</p>
    )
  }

  {
    course.sections.length === 0 && (
      <>
        {course.coursework && course.coursework.length > 0 && (
          <section aria-labelledby="coursework-title" class="border-t border-line py-12">
            <h2 id="coursework-title" class="text-2xl font-bold tracking-tight">Key coursework</h2>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {course.coursework.map((item) => (
                <li class="rounded-md border border-line bg-surface px-4 py-3">{item}</li>
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</Base>

<script>
  // Mark the section in view on the section bar: the last section whose top has scrolled
  // past the bar. Runs on scroll (throttled to animation frames) and once at load.
  const bar = document.getElementById('section-bar');
  if (bar) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('a[data-section]')];
    const sections = links.map((a) => document.getElementById(a.dataset.section!)!);
    let queued = false;
    const update = () => {
      queued = false;
      const line = bar.getBoundingClientRect().bottom + 8;
      let current = -1;
      sections.forEach((s, i) => {
        if (s.getBoundingClientRect().top <= line) current = i;
      });
      links.forEach((a, i) => {
        if (i === current) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      // Keep the current chip visible when the bar scrolls sideways on a phone.
      if (current >= 0) {
        const chip = links[current].parentElement!;
        const list = chip.parentElement!;
        if (chip.offsetLeft < list.scrollLeft || chip.offsetLeft + chip.offsetWidth > list.scrollLeft + list.clientWidth) {
          list.scrollLeft = chip.offsetLeft - 8;
        }
      }
    };
    addEventListener('scroll', () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
