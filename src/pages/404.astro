---
import Base from '../layouts/Base.astro';
import { courses } from '../data/courses';
---

<Base title="Page not found" sheet="404">
  <section class="grid place-items-center py-20 text-center sm:py-28">
    <div class="crop-marks w-full max-w-xl rounded-md border-2 border-line bg-surface px-6 py-12 sm:px-10">
      <p class="label">Inspection report</p>
      <p class="mt-4 font-mono text-7xl font-bold text-accent sm:text-8xl">404</p>
      <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">Out of tolerance</h1>
      <p class="mx-auto mt-3 max-w-sm text-muted">
        This page isn't on the drawing. It may have moved, or the link has a typo.
      </p>

      <!-- A little tolerance callout -->
      <div class="mx-auto mt-8 flex max-w-xs items-center gap-2 font-mono text-xs text-highlight" aria-hidden="true">
        <span class="h-3 border-l-2 border-current"></span>
        <span class="h-px flex-1 bg-current"></span>
        <span>URL ±0.000</span>
        <span class="h-px flex-1 bg-current"></span>
        <span class="h-3 border-l-2 border-current"></span>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-md bg-accent px-5 py-2.5 font-medium text-accent-ink transition hover:-translate-y-0.5">Back to home</a>
        {
          courses.map((c) => (
            <a href={`/${c.slug}`} class="rounded-md border-2 border-line px-5 py-2.5 font-medium transition hover:border-accent hover:text-accent">
              {c.code} work
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
